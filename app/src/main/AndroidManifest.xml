<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <attribution
        android:tag="@string/empty_attribution_tag"
        android:label="@string/attribution_label" />

    <!-- App 内自更新：下载正式版 APK 后调起系统安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 云端语音会话前检查网络可用性（普通权限，无需用户授权） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- MANAGE_EXTERNAL_STORAGE 已删除（2026-10-06 审查）：全仓从未请求或行使
         该全文件访问权限，纯增权限面与商店政策风险，无功能收益 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 外部调用面（WO52 4.1）：仅与 Hime 同签名的应用可调起 ExternalActionActivity -->
    <permission
        android:name="com.jobeen.hime.permission.EXTERNAL_ACTION"
        android:protectionLevel="signature" />
    <!-- 后台定期同步：跨重启持久化任务需此权限（JobScheduler setPersisted） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 通知渠道（WO52 13.1）：前台服务声明＋Android 13+ 通知运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name="com.jobeen.hime.ImeApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_feng_tile_cyan"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_feng_tile_cyan_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ime">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ime">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hime" android:host="com.jobeen.hime" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口：LauncherAlias 为历史保留别名（默认禁用，图标已换默认风青；切变体时启用对应 IconAlias 并禁用其余，Flare 式单选），主 Activity 本身不是启动入口。 -->
        <activity-alias
            android:name=".ui.LauncherAlias"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_feng_tile_cyan"
            android:roundIcon="@mipmap/ic_feng_tile_cyan_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

